# Copy to .env and edit. Every value here is optional — sift works with no
# configuration at all, indexing your Downloads folder with local models.
#
# Precedence: CLI flag  >  environment variable  >  .env  >  built-in default

# --- Where your files are -------------------------------------------------
# Defaults to your OS's Downloads folder (resolved per-platform, including
# localized names on Linux). Override to point sift somewhere else.
# SIFT_SOURCE=/Users/you/Documents

# Where the index lives. Defaults to your platform's user-data directory
# (~/Library/Application Support/sift, $XDG_DATA_HOME/sift, %LOCALAPPDATA%\sift).
# SIFT_DATA_DIR=/Users/you/.sift

# --- Models ---------------------------------------------------------------
# Defaults are local Ollama models — free, and nothing leaves your machine.
# SIFT_EMBED_MODEL=ollama/nomic-embed-text
# SIFT_CHAT_MODEL=ollama_chat/llama3.1:8b

# --- Retrieval knobs ------------------------------------------------------
# These were MEASURED on one folder of real documents and do not transfer to a
# different embedding model. See docs/DESIGN.md#calibrating-the-relevance-bar.
# SIFT_TOP_K=5
# SIFT_MIN_SCORE=0.55        # grounding bar for `sift ask`
# SIFT_FIND_MIN_SCORE=0.40   # looser candidate bar for `sift find`
# SIFT_LEXICAL_GATE=0        # turn OFF the word check. On by default: if a word
#                            # in your question is in none of your documents,
#                            # `sift ask` refuses and names it, before embedding
#                            # anything. Turn it off if it refuses a question it
#                            # should answer — see docs/DESIGN.md.
# SIFT_MAX_FILE_MB=50

# --- Chunking -------------------------------------------------------------
# Each passage is cut twice: indexed small so the embedding is about one thing,
# served large so the model can see enough to be right.
# SIFT_CHUNK_SIZE=1000       # the window the model is handed
# SIFT_CHUNK_OVERLAP=150     # characters shared between adjacent windows
# SIFT_CHILD_SIZE=300        # the smaller unit that actually gets embedded; 0 = off
# SIFT_CHILD_MIN=200         # floor on it, so a passage keeps its subject
# SIFT_DOC_HEAD_CHARS=120    # the document's opening line, carried on each
#                            # served passage so it can be attributed; 0 = off

# --- Cloud models (OFF by default) ----------------------------------------
# Using a cloud model sends the text of your documents to that provider.
# Your Downloads folder holds bank statements, IDs and contracts, so this
# requires an explicit opt-in and is never inferred from the model string.
#
# Permission is asked per command, for the models that command actually calls:
# `sift index` and `sift find` only use the embedding model, so a local
# embedder with a cloud chat model needs no opt-in to index or search.
# SIFT_ALLOW_CLOUD=1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Self-hosted model servers --------------------------------------------
# `huggingface/...` goes to router.huggingface.co unless you point it at your
# own endpoint, so sift counts it as a CLOUD model until one of these is set.
# HF_API_BASE=http://localhost:8080
# HUGGINGFACE_API_BASE=http://localhost:8080
#
# `ollama/`, `ollama_chat/`, `lm_studio/` and `local/` always count as local:
# they can only ever reach a server you chose. LM Studio still needs its own
# base URL for litellm to find it — sift does not read this one.
# LM_STUDIO_API_BASE=http://localhost:1234/v1
